# `.env`로 복사해서 쓰세요. (이 프로젝트는 dotenv를 쓰지 않고 환경변수만 읽습니다)
DATABASE_URL=sqlite://board.db?mode=rwc
JWT_SECRET=dev-only-insecure-secret-change-me
BIND_ADDR=127.0.0.1:4000
STATIC_DIR=static
# HTTPS로 서비스할 때만 true (쿠키에 Secure 속성이 붙습니다)
SECURE_COOKIE=false
RUST_LOG=web=debug,domain=debug,tower_http=info
# IP당 분당 허용 요청 수 (초과하면 429 RATE_LIMITED). 0이면 제한 없음.
RATE_LIMIT_PER_MINUTE=300
