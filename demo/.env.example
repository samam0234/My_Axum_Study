# 이 파일을 `.env`로 복사해서 값을 채웁니다. (.env는 커밋하지 않습니다)

# SQLite 파일 경로. mode=rwc = read/write/create
DATABASE_URL=sqlite://data.db?mode=rwc

# JWT 서명 키 — 운영에서는 반드시 충분히 긴 무작위 값으로 바꾸세요.
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=dev-only-insecure-secret-change-me

# 서버 바인드 주소. 컨테이너에서는 0.0.0.0:3000 을 씁니다.
BIND_ADDR=127.0.0.1:3000

# 업로드 파일 저장 폴더
UPLOAD_DIR=uploads

# 로그 레벨 (tracing EnvFilter 문법)
#   예) warn / demo=debug,tower_http=debug / axum::rejection=trace
RUST_LOG=demo=debug,tower_http=debug
