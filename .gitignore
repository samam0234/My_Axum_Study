# Rust build output
**/target/

# env
**/.env
**/.env.*
!**/.env.example

# db (sqlx/SeaORM SQLite 파일)
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3

# uploaded files (폴더 구조만 유지)
**/uploads/*
!**/uploads/.gitkeep

# logs
**/*.log

# editor
.vscode/*
!.vscode/extensions.json

# lab 예제가 실행 중에 만드는 파일
**/todos.json
**/todos.json.tmp
